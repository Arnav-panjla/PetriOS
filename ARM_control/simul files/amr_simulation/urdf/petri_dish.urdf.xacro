<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="petri_dish">

  <link name="petri_dish_link">

    <!-- Visual representation: 90 mm diameter x 15 mm height -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.015"/>
      </geometry>
      <material name="petri_material">
        <color rgba="0.95 0.85 0.40 0.8"/>
      </material>
    </visual>

    <!-- Collision representation -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.015"/>
      </geometry>
    </collision>

    <!-- Inertial properties for 18g dish -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.018"/>
      <inertia
        ixx="0.00000945"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00000945"
        iyz="0.0"
        izz="0.00001822"/>
    </inertial>

  </link>

  <!-- Gazebo properties -->
  <!-- ========================================================= -->
  <!-- MODEL-LEVEL GAZEBO PROPERTIES                             -->
  <!-- ========================================================= -->

  <gazebo>
    <static>false</static>
  </gazebo>


  <!-- ========================================================= -->
  <!-- PETRI DISH LINK GAZEBO PROPERTIES                        -->
  <!-- ========================================================= -->

  <gazebo reference="petri_dish_link">

    <material>Gazebo/AmberTransparent</material>

    <visual>
      <material>
        <ambient>0.95 0.85 0.40 0.8</ambient>
        <diffuse>0.95 0.85 0.40 0.8</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>
</robot>