  <link name="link_0"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="link_4"/>
  <link name="link_5"/>
  <link name="tool"/>

  <joint name="joint_0" type="revolute">
