<?xml version="1.0"?>
<!--
  Placeholder only. Link lengths, masses, and joint axes are NOT measured.
  A joint angle of 0 rad is this software's minimum pulse, and the upper
  limit is that joint's maximum pulse (180 degrees). Do not use this file
  for inverse kinematics, collision checking, or simulation.
  Referenced by robot_arm.kinematics.model.UncalibratedKinematics and README.md.
-->
<robot name="petri_arm_placeholder">
