<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera_shousing">

  <link name="camera_shousing_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://camera_housing/meshes/camera_shousing_no_roof_collision.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_camera">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://camera_housing/meshes/camera_shousing_no_roof_collision.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <!-- The roof's front U opening is 110 mm wide and 110 mm deep. A level
         90 mm dish can descend at the front of the housing with 10 mm side
         clearance, then slide under the rear strip to the shelf. -->
    <visual>
      <origin xyz="-0.025 0.080 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.050 0.160 0.005"/></geometry>
      <material name="mat_camera"/>
    </visual>
    <collision>
      <origin xyz="-0.025 0.080 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.050 0.160 0.005"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.105 0.0125 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.110 0.025 0.005"/></geometry>
      <material name="mat_camera"/>
    </visual>
    <collision>
      <origin xyz="-0.105 0.0125 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.110 0.025 0.005"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.105 0.1475 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.110 0.025 0.005"/></geometry>
      <material name="mat_camera"/>
    </visual>
    <collision>
      <origin xyz="-0.105 0.1475 0.1825" rpy="0 0 0"/>
      <geometry><box size="0.110 0.025 0.005"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

  </link>

  <gazebo reference="camera_shousing_link">
    <material>Gazebo/Grey</material>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

</robot>

