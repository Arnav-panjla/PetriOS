<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_system">

  <!-- ========================================================= -->
  <!-- SUBSYSTEM INCLUDES                                        -->
  <!-- ========================================================= -->

  <xacro:include
    filename="$(find robot_arm_description)/urdf/robot_arm_gazebo_gui_sync.urdf.xacro"/>

  <xacro:include
    filename="$(find carousel_description)/urdf/carousel_gazebo.urdf.xacro"/>

  <xacro:include
    filename="$(find camera_housing)/urdf/camera_stand_gazebo.urdf.xacro"/>


  <!-- ========================================================= -->
  <!-- GLOBAL WORLD FRAME                                        -->
  <!-- ========================================================= -->

  <link name="world"/>


  <!-- ========================================================= -->
  <!-- SCARA ARM                                                 -->
  <!--                                                             -->
  <!-- Physical/reference position:                              -->
  <!-- X =  0.000 m                                              -->
  <!-- Y =  0.000 m                                              -->
  <!--                                                             -->
  <!-- This is the top vertex of the equilateral triangle.       -->
  <!-- ========================================================= -->

  <joint name="world_to_arm" type="fixed">

    <parent link="world"/>
    <child link="base_link"/>

    <origin
      xyz="0.000000 0.000000 0.000000"
      rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- CAROUSEL                                                   -->
  <!-- The orange U notch between two blue vertical dividers faces the arm. -->
  <!-- Plate yaw = carousel yaw (-15 deg) + plate joint yaw (30 deg). -->
  <!-- Carousel and dish station shifted 50 mm inward radially. -->
  <!-- ========================================================= -->

  <joint name="world_to_carousel" type="fixed">

    <parent link="world"/>
    <child link="carousel_base_link"/>

    <origin
      xyz="0.318198 -0.318198 0.000000"
      rpy="0 0 -0.2617993878"/>

  </joint>


  <!-- ========================================================= -->
  <!-- CAMERA HOUSING                                             -->
  <!--                                                             -->
  <!-- The inner U shelf has an 85 mm recessed ledge; target dish centre is (0,-.47,.0925). -->
  <!-- The housing roof is 180-185 mm high, above the dish. -->
  <!-- Camera station shifted 20 mm inward toward the arm. -->
  <!-- ========================================================= -->

  <joint name="world_to_camera" type="fixed">

    <parent link="world"/>
    <child link="camera_shousing_link"/>

    <origin
        xyz="-0.080000 -0.550000 0.000000"
        rpy="0 0 -1.57079632679"/>

  </joint>

  <!-- <joint name="world_to_camera" type="fixed">

    <parent link="world"/>
    <child link="camera_shousing_link"/>

    <origin
        xyz="-0.280000 -0.4264101615 0.000000"
        rpy="0 0 -1.57079632679"/>

  </joint> -->
  <!-- ========================================================= -->
  <!-- GAZEBO STATIC SYSTEMS                                     -->
  <!-- ========================================================= -->

  <gazebo reference="carousel_base_link">
    <static>true</static>
  </gazebo>

  <gazebo reference="camera_shousing_link">
    <static>true</static>
  </gazebo>

  <!-- Simulation-only grip proxy; the separate dish is attached at the
       actual grasp pose and detached after it rests at the camera stand. -->
  <gazebo>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link_5</parent_link>
      <child_model>petri_dish_1</child_model>
      <child_link>petri_dish_link</child_link>
      <attach_topic>/petri_dish_1/attach</attach_topic>
      <detach_topic>/petri_dish_1/detach</detach_topic>
      <output_topic>/petri_dish_1/state</output_topic>
    </plugin>
  </gazebo>

</robot>
