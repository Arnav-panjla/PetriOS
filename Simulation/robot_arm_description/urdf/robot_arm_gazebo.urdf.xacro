<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm_with_gripper">

  <!-- ========================================================= -->
  <!-- BASE LINK -->
  <!-- ========================================================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_base">
        <color rgba="0.55 0.55 0.58 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.038" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>


  <!-- ========================================================= -->
  <!-- LINK 1 -->
  <!-- ========================================================= -->

  <link name="link_1">
    <visual>
      <origin xyz="-0.000000 0.029745 -0.071600" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_link_1">
        <color rgba="0.15 0.45 0.90 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.000000 0.029745 -0.071600" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>


  <!-- ========================================================= -->
  <!-- LINK 2 -->
  <!-- ========================================================= -->

  <link name="link_2">
    <visual>
      <origin xyz="-0.008600 0.039745 -0.090850" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_link_2">
        <color rgba="0.20 0.70 0.35 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.008600 0.039745 -0.090850" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>


  <!-- ========================================================= -->
  <!-- LINK 3 -->
  <!-- ========================================================= -->

  <link name="link_3">
    <visual>
      <origin xyz="-0.008600 0.039745 -0.201340" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_link_3">
        <color rgba="0.95 0.50 0.12 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.008600 0.039745 -0.201340" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>


  <!-- ========================================================= -->
  <!-- LINK 4 -->
  <!-- ========================================================= -->

  <link name="link_4">
    <visual>
      <origin xyz="-0.008600 0.170236 -0.201340" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_link_4">
        <color rgba="0.65 0.30 0.85 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.008600 0.170236 -0.201340" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>


  <!-- ========================================================= -->
  <!-- LINK 5 -->
  <!-- LINK 5 + GRIPPER GEAR ASSEMBLY -->
  <!-- ========================================================= -->

  <link name="link_5">
    <visual>
      <origin xyz="-0.018601 0.237482 -0.201339" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_link_5">
        <color rgba="0.95 0.80 0.15 1.0"/>
      </material>
    </visual>

    <!-- Integrated Gripper Gear visual element on Link 5 -->
    <visual>
      <origin
        xyz="-0.018601 0.237482 -0.201339"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://robot_arm_description/meshes/gripper_gear.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>

      <material name="mat_gripper_gear">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.018601 0.237482 -0.201339" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0008"/>
      <mass value="0.45"/>
      <inertia ixx="0.0009" ixy="0.0" ixz="0.0" iyy="0.0009" iyz="0.0" izz="0.0009"/>
    </inertial>
  </link>


  <!-- ========================================================= -->
  <!-- ARM JOINTS WITH DAMPING & FRICTION                        -->
  <!-- ========================================================= -->

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0.000000 -0.029745 0.071600" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.0"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.008600 -0.010000 0.019250" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.0"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.000000 0.000000 0.110490" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.0"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.000000 -0.130491 0.000000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.0"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.010001 -0.067246 -0.000001" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="2.0"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- LEFT GRIPPER LINK -->
  <!-- LEFT GRIPPER LINK (VISUAL ONLY FOR LINKAGE KINEMATICS)    -->
  <!-- ========================================================= -->

  <link name="left_gripper_link">
    <visual>
      <origin xyz="-0.014123 0.301592 -0.205839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/left_gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_left_gripper">
        <color rgba="0.10 0.75 0.80 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.014123 0.301592 -0.205839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/left_gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
      <mass value="0.02"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="left_gripper_link_joint" type="revolute">
    <parent link="link_5"/>
    <child link="left_gripper_link"/>

    <origin
      xyz="-0.004478 -0.064110 0.004500"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.8"
      upper="0.8"
      effort="20.0"
      velocity="2.0"/>

    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ========================================================= -->
  <!-- RIGHT GRIPPER LINK -->
  <!-- RIGHT GRIPPER LINK (VISUAL ONLY FOR LINKAGE KINEMATICS)   -->
  <!-- ========================================================= -->

  <link name="right_gripper_link">
    <visual>
      <origin xyz="-0.023127 0.301587 -0.205839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/right_gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_right_gripper">
        <color rgba="0.90 0.30 0.60 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.023127 0.301587 -0.205839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/right_gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
      <mass value="0.02"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="right_gripper_link_joint" type="revolute">
    <parent link="link_5"/>
    <child link="right_gripper_link"/>

    <origin
      xyz="0.004526 -0.064105 0.004500"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.8"
      upper="0.8"
      effort="20.0"
      velocity="2.0"/>

    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ========================================================= -->
  <!-- LEFT FINGER -->
  <!-- LEFT FINGER (ACTIVE COLLISION SURFACE FOR GRASPING)       -->
  <!-- ========================================================= -->

  <link name="left_finger">
    <visual>
<origin xyz="-0.012620 0.306298 -0.199839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/left_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_left_finger">
        <color rgba="0.20 0.85 0.65 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.002620 0.292298 -0.199839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/left_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="revolute">
    <parent link="link_5"/>
    <child link="left_finger"/>
    <origin xyz="-0.005981 -0.068816 -0.001500" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ========================================================= -->
  <!-- RIGHT FINGER -->
  <!-- RIGHT FINGER (ACTIVE COLLISION SURFACE FOR GRASPING)      -->
  <!-- ========================================================= -->

  <link name="right_finger">
    <visual>
<origin xyz="-0.044280 0.306093 -0.202839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/right_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mat_right_finger">
        <color rgba="0.95 0.45 0.30 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.034280 0.292093 -0.202839" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/right_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="revolute">
    <parent link="link_5"/>
    <child link="right_finger"/>

    <origin
      xyz="0.025679 -0.068611 0.001500"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.8"
      upper="0.8"
      effort="20.0"
      velocity="2.0"/>

    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Disable self collision exploding between arm links -->
  <!-- Disable self collision popping between arm links -->
  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>


  <!-- ========================================================= -->
  <!-- ROS 2 CONTROL                                             -->
  <!-- ========================================================= -->

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ======================= -->
    <!-- JOINT 1                  -->
    <!-- ======================= -->

    <joint name="joint_1">

      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- ======================= -->
    <!-- JOINT 2                  -->
    <!-- ======================= -->

    <joint name="joint_2">

      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- ======================= -->
    <!-- JOINT 3                  -->
    <!-- ======================= -->

    <joint name="joint_3">

      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- ======================= -->
    <!-- JOINT 4                  -->
    <!-- ======================= -->

    <joint name="joint_4">

      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- ======================= -->
    <!-- JOINT 5                  -->
    <!-- ======================= -->

    <joint name="joint_5">

      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <joint name="left_finger_joint">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_gripper_link_joint">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_gripper_link_joint">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
  </ros2_control>


  <!-- ========================================================= -->
  <!-- GAZEBO ROS 2 CONTROL PLUGIN                              -->
  <!-- ========================================================= -->

  <gazebo>

    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find robot_arm_description)/config/arm_controllers.yaml
      </parameters>

      <controller_manager_name>
        controller_manager
      </controller_manager_name>

    </plugin>

  </gazebo>

</robot>
